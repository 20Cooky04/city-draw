<%# app/views/cells/index.html.erb %>

<div class="city-grid-page">
  <div class="city-grid-nav city-grid-nav--top">
    <%= link_to "↑ Up",
          cells_path(offset_row: @offset_row - 1, offset_column: @offset_column),
          class: "grid-arrow #{'grid-arrow--disabled' if @offset_row <= 0}" %>
  </div>

  <div class="city-grid-nav city-grid-nav--middle">
    <%= link_to "← Left",
          cells_path(offset_row: @offset_row, offset_column: @offset_column - 1),
          class: "grid-arrow #{'grid-arrow--disabled' if @offset_column <= 0}" %>

    <div class="city-grid"
         data-controller="sprite-walker"
         data-sprite-walker-draw-canvas-size-value="<%= GridConfig::DRAW_CANVAS_SIZE %>"
         data-sprite-walker-nature-image-url-value="<%= asset_path('sprites/bird.svg') %>"
         data-sprite-walker-building-image-url-value="<%= asset_path('sprites/car.svg') %>"
         style="position: relative;
                grid-template-columns: repeat(<%= GridConfig::VIEWPORT_COLUMNS %>, <%= GridConfig::CELL_SIZE %>px);
                grid-template-rows: repeat(<%= GridConfig::VIEWPORT_ROWS %>, <%= GridConfig::CELL_SIZE %>px);">
      <% (@offset_row...(@offset_row + GridConfig::VIEWPORT_ROWS)).each do |row| %>
        <% (@offset_column...(@offset_column + GridConfig::VIEWPORT_COLUMNS)).each do |column| %>
          <% cell = @cells_by_position[[row, column]] %>
          <div class="city-grid__cell"
               style="width: <%= GridConfig::CELL_SIZE %>px; height: <%= GridConfig::CELL_SIZE %>px;"
               <% if cell %>
                 data-sprite-walker-target="cell"
                 data-row="<%= row %>"
                 data-column="<%= column %>"
                 data-category="<%= cell.category %>"
                 data-completed="<%= cell.completed? %>"
                 data-prompt="<%= cell.prompt %>"
                 <% if cell.completed? %>data-strokes="<%= cell.strokes %>"<% end %>
               <% end %>>
            <% if cell&.completed? %>
              <%= link_to cell_path(cell), class: "city-grid__thumb-link" do %>
                <svg viewBox="0 0 <%= GridConfig::DRAW_CANVAS_SIZE %> <%= GridConfig::DRAW_CANVAS_SIZE %>" class="city-grid__thumb">
                  <% JSON.parse(cell.strokes).each do |stroke| %>
                    <path d="<%= stroke_to_svg_path(stroke) %>"
                          stroke="black" fill="none"
                          stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  <% end %>
                </svg>
              <% end %>
            <% elsif cell %>
              <%= link_to "Draw", cell_path(cell), class: "city-grid__empty" %>
            <% else %>
              <div class="city-grid__missing"></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= link_to "Right →",
          cells_path(offset_row: @offset_row, offset_column: @offset_column + 1),
          class: "grid-arrow #{'grid-arrow--disabled' if @offset_column >= GridConfig::TOTAL_COLUMNS - GridConfig::VIEWPORT_COLUMNS}" %>
  </div>

  <div class="city-grid-nav city-grid-nav--bottom">
    <%= link_to "↓ Down",
          cells_path(offset_row: @offset_row + 1, offset_column: @offset_column),
          class: "grid-arrow #{'grid-arrow--disabled' if @offset_row >= GridConfig::TOTAL_ROWS - GridConfig::VIEWPORT_ROWS}" %>
  </div>
</div>

<style>
  .city-grid-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .city-grid-nav--middle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .city-grid {
    display: grid;
    gap: 0;
    background: #fff;
    border: 1px solid #ccc;
  }
  .city-grid__cell {
    position: relative;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid transparent;
    transition: border-color 0.1s ease;
  }
  .city-grid__cell:hover {
    border-color: #ccc;
    z-index: 5; /* lift above neighboring cells and sprites so the border isn't overlapped */
  }
  .city-grid__thumb-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .city-grid__thumb {
    width: 100%;
    height: 100%;
  }

  /* Prompt tooltip — shown on hover, pinned to the top edge, inside the cell */
  .city-grid__cell[data-prompt]::before {
    content: attr(data-prompt);
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    max-width: calc(100% - 8px);
    background: #000;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
    z-index: 10;
  }
  .city-grid__cell[data-prompt]:hover::before {
    opacity: 1;
  }
  .city-grid__empty {
    font-size: 0.75rem;
    color: #888;
    text-decoration: none;
  }
  .city-grid__missing {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, #f5f5f5, #f5f5f5 4px, #eee 4px, #eee 8px);
  }
  .grid-arrow--disabled {
    pointer-events: none;
    opacity: 0.3;
  }

  /* Walking sprites — see sprite_walker_controller.js#buildSpriteElement.
     Position/rotation are set via inline style.transform on .sprite-placeholder
     itself (translate to center + rotate to face direction of travel); the
     img just fills the box. */
  .sprite-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 6;
  }
  .sprite-placeholder img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
